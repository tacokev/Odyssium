<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InnerTune" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#ffffff</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The app draws its own light/dark theme (Compose). Without this, the Light parent
             lets Android's automatic "force dark" invert parts of the screen on its own - it
             was flipping top bars and panels to light colors over big bright content like the
             Drake comic pages. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Video playback: black behind the player from the first frame, rather than a white flash. -->
    <style name="Theme.InnerTune.Video">
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
